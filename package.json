{
  "name": "bilibili-live-tasks-helper",
  "private": true,
  "version": "7.3.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-minify {@}\" --",
    "build-minify": "run-s \"build-only {@}\" minify --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s -c lint:eslint lint:stylelint",
    "lint:eslint": "eslint . --fix --cache",
    "lint:stylelint": "stylelint \"src/**/*.{css,less,scss,vue}\" --fix --cache",
    "lint:eslint:check": "eslint . --cache",
    "lint:stylelint:check": "stylelint \"src/**/*.{css,less,scss,vue}\" --cache",
    "lint:check": "run-p -c lint:eslint:check lint:stylelint:check",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check --experimental-cli src/",
    "docs:check": "markdownlint-cli2",
    "docs:fix": "markdownlint-cli2 --fix",
    "minify": "node scripts/minifyUserscript.js",
    "svg2vue": "node scripts/convertSvgToVue.js"
  },
  "dependencies": {
    "ajax-hook": "^3.0.3",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.14.8",
    "hotkeys-js": "^4.1.2",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.6",
    "@types/crypto-js": "^4.2.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "svgo": "^4.1.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-monkey": "^8.1.1",
    "vue-tsc": "3.3.11",
    "markdownlint-cli2": "^0.24.2"
  }
}
